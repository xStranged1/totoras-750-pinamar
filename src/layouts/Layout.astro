---
import "@/styles/global.css";
import { SITE, BASE } from "@/config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Departamentos en Pinamar para estadías cortas | Totoras 750",
  description = "Alquiler de dos monoambientes y un departamento familiar en Pinamar, en Totoras 750. Supermercado al lado, plaza a 50 m, Av. Bunge a 500 m y Camino parque \"Los pioneros\" a 800 m. Consultá por WhatsApp.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${BASE}images/12-dormitorio-king-balcon.jpg`, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: "Totoras 750 - Departamentos en Pinamar",
  description,
  url: canonical.toString(),
  telephone: `+${SITE.whatsapp}`,
  image: ogImage.toString(),
  address: {
    "@type": "PostalAddress",
    streetAddress: "Totoras 750",
    addressLocality: "Pinamar",
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
  petsAllowed: false,
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
